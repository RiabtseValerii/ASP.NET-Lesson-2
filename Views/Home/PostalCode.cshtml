@{
    ViewData["Title"] = ViewBag.City.Name;
}

<h1>@ViewData["Title"]</h1>

<div class="card">
    <img src="@ViewBag.City.MainImageUrl" class="img-fluid" alt="Image of @ViewBag.City.Name">
    <div class="card-body">
        <h3>Postal Code: @ViewBag.City.PostalCode</h3>
    </div>
</div>
